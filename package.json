{
  "name": "learn-claude-code-typescript",
  "version": "1.0.0",
  "description": "TypeScript implementation of Learn Claude Code - An educational project teaching how to build AI coding agents",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "echo \"No integration test suite in strict mirror mode\"",
    "s01": "node --loader ts-node/esm agents/s01_agent_loop.ts",
    "s02": "node --loader ts-node/esm agents/s02_tool_use.ts",
    "s03": "node --loader ts-node/esm agents/s03_todo_write.ts",
    "s04": "node --loader ts-node/esm agents/s04_subagent.ts",
    "s05": "node --loader ts-node/esm agents/s05_skill_loading.ts",
    "s06": "node --loader ts-node/esm agents/s06_context_compact.ts",
    "s07": "node --loader ts-node/esm agents/s07_task_system.ts",
    "s08": "node --loader ts-node/esm agents/s08_background_tasks.ts",
    "s09": "node --loader ts-node/esm agents/s09_agent_teams.ts",
    "s10": "node --loader ts-node/esm agents/s10_team_protocols.ts",
    "s11": "node --loader ts-node/esm agents/s11_autonomous_agents.ts",
    "s12": "node --loader ts-node/esm agents/s12_worktree_task_isolation.ts",
    "s:full": "node --loader ts-node/esm agents/s_full.ts",
    "extras:permission": "node --loader ts-node/esm agents/extras/s07_permission_system.ts",
    "extras:hook": "node --loader ts-node/esm agents/extras/s08_hook_system.ts",
    "extras:memory": "node --loader ts-node/esm agents/extras/s09_memory_system.ts",
    "extras:sysprompt": "node --loader ts-node/esm agents/extras/s10_system_prompt.ts",
    "extras:recovery": "node --loader ts-node/esm agents/extras/s11_error_recovery.ts",
    "extras:cron": "node --loader ts-node/esm agents/extras/s14_cron_scheduler.ts",
    "extras:mcp": "node --loader ts-node/esm agents/extras/s19_mcp_plugin.ts",
    "extras:full-all19": "node --loader ts-node/esm agents/extras/s_full_all19.ts",
    "type-check": "tsc --noEmit",
    "web:build": "npm --prefix web run build"
  },
  "keywords": [
    "anthropic",
    "claude",
    "ai",
    "agents",
    "typescript",
    "education",
    "tutorial"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
